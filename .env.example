# URL của backend Express (không có /api/v1 ở cuối)
BACKEND_URL=http://localhost:5000
# API key hợp lệ đã seed trong DB backend (permission phải chứa 0000)
API_KEY=
# Số reverse proxy đứng TRƯỚC Next.js (Vercel/nginx = 1, thêm Cloudflare = 2).
# 0 = không có proxy (local dev) → không gửi IP người dùng sang backend, vì khi
# đó X-Forwarded-For do client tự điền. Xem
# Ecommerce-NodeJS/docs/22. client-ip-forwarding-guide.md
TRUST_PROXY=0
